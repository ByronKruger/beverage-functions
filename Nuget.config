<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="AzureDevOpsFeed"
			 value="https://pkgs.dev.azure.com/YOUR_ORG/YOUR_PROJECT/_packaging/YOUR_FEED/nuget/v3/index.json"
			 protocolVersion="3" />
	</packageSources>

	<!-- Credentials section - left empty for local/CI injection -->
	<packageSourceCredentials>
		<AzureDevOpsFeed>
			<add key="Username" value="ANYTHING" />
			<add key="ClearTextPassword" value="" />
			<!-- CI or local tools fill this -->
		</AzureDevOpsFeed>
	</packageSourceCredentials>
</configuration>

